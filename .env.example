# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Note: HOST=0.0.0.0 exposes the server to your local network
# Use HOST=127.0.0.1 to restrict to localhost only

# Database
DATABASE_PATH=./data/firefly.db

# Better Auth
BETTER_AUTH_SECRET=auto-generated-on-first-run
BETTER_AUTH_URL=http://localhost:3000
